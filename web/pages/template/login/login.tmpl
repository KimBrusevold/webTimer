{{ template "header" }}
<main>
    <h2>Trappeløp</h2>
    <div >
      <form action="/aut/innlogging" method="post">
        <label for="email">Epost</label>
        <input type="email" name="email" id="email" required />
        
        <label for="password">Passord</label>
        <input type="password" name="password" id="password" required />
        
        <input type="submit" value="Logg inn" />
      </form>
      <div>
        <a href="/aut/nytt-passord">Glemt passordet?</a>
        <a href="/aut/registrer-bruker">Registrer deg for å delta</a>
      </div>
    </div>
</main>
{{ template "footer" }}